{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "enabledManagers": ["custom.regex", "composer", "npm", "github-actions"],
    "semanticCommits": "enabled",
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps",
    "commitMessageTopic": "{{depName}}",
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": ["(^|/)\\.qlty/qlty\\.toml$"],
            "matchStrings": [
                "sinemacula/coding-standards\"[\\s\\S]*?tag\\s*=\\s*\"(?<currentValue>v[0-9.]+)\""
            ],
            "depNameTemplate": "sinemacula/coding-standards",
            "datasourceTemplate": "github-tags"
        },
        {
            "customType": "regex",
            "fileMatch": ["(^|/)\\.qlty/qlty\\.toml$"],
            "matchStrings": [
                "\"sinemacula/coding-standards@(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "sinemacula/coding-standards",
            "datasourceTemplate": "packagist"
        },
        {
            "customType": "regex",
            "fileMatch": ["(^|/)\\.qlty/configs/biome\\.json$"],
            "matchStrings": [
                "coding-standards/(?<currentValue>v[0-9.]+)/js/biome\\.json"
            ],
            "depNameTemplate": "sinemacula/coding-standards",
            "datasourceTemplate": "github-tags"
        }
    ],
    "packageRules": [
        {
            "description": "Manage only sinemacula/coding-standards itself; ignore everything else",
            "matchPackageNames": ["!sinemacula/coding-standards", "!@sinemacula/coding-standards", "!sinemacula/coding-standards-laravel"],
            "enabled": false
        },
        {
            "description": "Raise workflow action and reusable workflow updates as one reviewed PR",
            "matchManagers": ["github-actions"],
            "enabled": true,
            "groupName": "GitHub Actions"
        },
        {
            "description": "Pin third-party actions to a commit digest, with the tag in a trailing comment; GitHub's and this organization's stay on their tags",
            "matchManagers": ["github-actions"],
            "matchPackageNames": ["!actions/**", "!github/**", "!sinemacula/**"],
            "pinDigests": true
        },
        {
            "description": "Group the qlty tag, composer and npm bumps into one PR; auto-merge minor and patch",
            "matchPackageNames": ["sinemacula/coding-standards", "@sinemacula/coding-standards", "sinemacula/coding-standards-laravel"],
            "groupName": "Sine Macula coding standards",
            "rangeStrategy": "bump",
            "automerge": true
        },
        {
            "matchUpdateTypes": ["major"],
            "automerge": false
        }
    ]
}
