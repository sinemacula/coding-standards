# Run via `composer analyse`, not qlty: qlty Cloud never runs `composer
# install`, so it can load neither PHP_CodeSniffer's source nor the in-repo rule.
includes:
    - php/phpstan-base.neon

parameters:
    # qlty pins 9 everywhere else; this repo bypasses qlty, so it states it.
    level: 9

    # phpcs 4.x tightens some PHPDoc return types, so null guards still needed
    # on 3.x would otherwise read as always false.
    treatPhpDocTypesAsCertain: false

    # PHP_CodeSniffer's classes are not on the Composer classmap.
    scanDirectories:
        - vendor/squizlabs/php_codesniffer/src

    paths:
        - src
        - SineMacula/Sniffs
        - SineMacula/Tests

    ignoreErrors:
        # PHP_CodeSniffer exposes token data as mixed.
        - identifier: offsetAccess.invalidOffset
        - identifier: binaryOp.invalid
        - identifier: assignOp.invalid
        - identifier: postInc.type
