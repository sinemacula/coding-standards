{
    "name": "@sinemacula/coding-standards",
    "version": "1.9.2",
    "description": "Centralized coding standards, static analysis configurations, and code quality tooling for all Sine Macula repositories.",
    "license": "Apache-2.0",
    "author": "Ben Carey <bdmc@sinemacula.co.uk>",
    "repository": {
        "type": "git",
        "url": "https://github.com/sinemacula/coding-standards.git"
    },
    "homepage": "https://github.com/sinemacula/coding-standards#readme",
    "bugs": {
        "url": "https://github.com/sinemacula/coding-standards/issues"
    },
    "keywords": [
        "biome",
        "knip",
        "eslint",
        "coding-standards",
        "linting",
        "config"
    ],
    "type": "module",
    "files": [
        "js/",
        "markdown/",
        "yaml/",
        "shell/",
        "security/",
        "README.md",
        "LICENSE",
        "NOTICE",
        "!js/eslint/rules/__tests__"
    ],
    "exports": {
        "./js/eslint": "./js/eslint/index.js",
        "./js/eslint/type-checked": "./js/eslint/type-checked.js",
        "./*": "./*"
    },
    "scripts": {
        "test:js": "vitest run",
        "lint:js": "eslint js/eslint"
    },
    "devDependencies": {
        "@typescript-eslint/rule-tester": "^8.0.0",
        "@typescript-eslint/utils": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-plugin-jsdoc": "^63.0.13",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^3.0.0"
    },
    "peerDependencies": {
        "eslint": ">=9",
        "eslint-plugin-jsdoc": ">=48",
        "typescript": ">=4.8.4",
        "typescript-eslint": "^8"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        },
        "eslint-plugin-jsdoc": {
            "optional": true
        },
        "typescript": {
            "optional": true
        },
        "typescript-eslint": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
