# Shared Swift 6 formatting policy.

--swiftversion 6.0
--indent 4
--linebreaks lf
--maxwidth 120
--trim-whitespace always
--xcode-indentation enabled

--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions before-first
--wrap-effects if-multiline
--wrap-return-type if-multiline
--closing-paren balanced
--call-site-paren balanced

# SwiftLint's sorted_imports ignores access level; the default grouping would
# make fmt and check disagree forever on access-level imports.
--import-grouping alpha
--trailing-commas never
--semicolons never
--self remove
--ifdef no-indent

# SwiftLint's file_header rule owns the copyright header.
--header ignore

# Unused arguments are stripped only where it cannot change a declared API.
--strip-unused-args closure-only

# Formatting must not change ownership, control flow, or API shape.
--anonymous-for-each ignore
--disable enumNamespaces,initCoderUnavailable,preferForLoop,redundantSendable,strongOutlets

# The single-line if body rules are on by default from 0.62 and left unnamed,
# since older versions reject unknown rules.

# Mirrors .swiftlint.yml; unlike `excluded:` there, this holds for explicit
# paths too.
--exclude .build,build,DerivedData,Carthage,Pods,vendor,**/Generated
