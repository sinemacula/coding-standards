<?xml version="1.0"?>
<ruleset name="SineMacula Project">

    <!--
        The standard is this repo, so it is referenced by path. autoload.php
        resolves the src/ base classes, as qlty Cloud has no project vendor.
    -->
    <rule ref="../../SineMacula/ruleset.xml"/>
    <autoload>autoload.php</autoload>

    <file>../../src</file>
    <file>../../SineMacula/Sniffs</file>
    <file>../../SineMacula/Tests</file>

    <!--
        Unsatisfiable in sniff code: Sniff::process() leaves $stackPtr untyped
        and PHP fatals if it is narrowed, and phpcs assigns sniff properties
        from the ruleset at runtime.
    -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude-pattern>*/Sniffs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ScalarTypeHintMissing">
        <exclude-pattern>*/Sniffs/*</exclude-pattern>
    </rule>
    <rule ref="SineMacula.Classes.RequireReadonlyPublicProperty">
        <exclude-pattern>*/Sniffs/*</exclude-pattern>
    </rule>

    <!-- All PHP here handles arbitrary token and configuration values. -->
    <rule ref="SlevomatCodingStandard.TypeHints.DisallowMixedTypeHint">
        <exclude-pattern>*/src/*</exclude-pattern>
        <exclude-pattern>*/Sniffs/*</exclude-pattern>
        <exclude-pattern>*/Tests/*</exclude-pattern>
    </rule>

    <!-- PHPStan's Rule::processNode() requires $scope even when unused. -->
    <rule ref="SlevomatCodingStandard.Functions.UnusedParameter">
        <exclude-pattern>*/PHPStan/*</exclude-pattern>
    </rule>

</ruleset>
