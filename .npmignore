# Defensive backstop - `files` in package.json is the primary allowlist, but
# npm still walks the working tree and applies .gitignore-like rules first.
# Anything below is excluded even if it matches a `files` entry.

# PHP-only distribution (Composer ships this separately as sinemacula/coding-standards).
src/
SineMacula/
php/
composer.json
composer.lock
vendor/
.php-cs-fixer.cache

# Repo tooling that doesn't belong in the npm tarball.
.github/
.idea/
.qlty/
.qodo/
.editorconfig
source.toml

# Rule test specs and fixtures - kept in git and CI, never shipped to consumers.
js/eslint/rules/__tests__/
vitest.config.js
