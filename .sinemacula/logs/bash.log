{"schema_version":1,"timestamp":"2026-06-21T13:32:32.225Z","command":"cd /Users/ben/Projects/sinemacula/Repositories/coding-standards\necho \"=== how PHP tokenizes 'use function X;' vs 'use const X;' ===\"\nphp -r '\nforeach ([\"use function App\\\\Support\\\\helper;\", \"use const App\\\\Support\\\\FOO;\"] as $code) {\n    echo \"--- <?php $code\\n\";\n    foreach (token_get_all(\"<?php \".$code) as $x) {\n        if (is_array($x) && $x[0] !== T_WHITESPACE) echo \"  \".token_name($x[0]).\" = \".trim($x[1]).\"\\n\";\n    }\n}'\necho \"=== parseImport: re-read the exact branch + line numbers ===\"\nsed -n '144,162p' SineMacula/Sniffs/Attributes/DisallowToolingAttributeSniff.php","cwd":".","session_id":"9a53099f-b58b-4687-996d-9f25e8e18acc","project_hash":"d0dd6af1f2bd","duration_ms":99}
