{"schema_version":1,"timestamp":"2026-06-21T13:27:44.134Z","command":"cd /Users/ben/Projects/sinemacula/Repositories/coding-standards\necho \"=== covered-class mapping per test ===\"\nfor t in $(find SineMacula/Tests -name '*Test.php' | sort); do\n  cat=$(basename \"$(dirname \"$t\")\")\n  name=$(basename \"$t\" Test.php)\n  if [ \"$cat\" = \"PHPStan\" ]; then\n    src=\"src/PHPStan/Rules/$name.php\"; fqcn=\"SineMacula\\\\CodingStandards\\\\PHPStan\\\\Rules\\\\$name\"\n  else\n    src=\"SineMacula/Sniffs/$cat/$name.php\"; fqcn=\"SineMacula\\\\Sniffs\\\\$cat\\\\$name\"\n  fi\n  ext=$(grep -h \"extends Abstract\" \"$src\" 2>/dev/null | grep -oE \"Abstract[A-Za-z]+\" | head -1)\n  printf \"%-55s -> %-55s exists=%s base=%s\\n\" \"$t\" \"$fqcn\" \"$([ -f \"$src\" ] && echo Y || echo N)\" \"${ext:-none}\"\ndone\necho \"=== FQCN of the abstract bases ===\"\ngrep -h \"^namespace\" src/Sniffs/AbstractMetricSniff.php src/Sniffs/AbstractRequiredNamespaceSniff.php","cwd":".","session_id":"9a53099f-b58b-4687-996d-9f25e8e18acc","project_hash":"d0dd6af1f2bd","duration_ms":318}
{"schema_version":1,"timestamp":"2026-06-21T13:29:17.523Z","command":"cd /Users/ben/Projects/sinemacula/Repositories/coding-standards\npython3 - <<'PY'\nimport os\n\nBASE = {\n  'Metrics': ('SineMacula\\\\CodingStandards\\\\Sniffs\\\\AbstractMetricSniff', 'AbstractMetricSniff'),\n  'Namespaces': ('SineMacula\\\\CodingStandards\\\\Sniffs\\\\AbstractRequiredNamespaceSniff', 'AbstractRequiredNamespaceSniff'),\n}\ncount = 0\nfor root, _, files in os.walk('SineMacula/Tests'):\n    for fn in sorted(files):\n        if not fn.endswith('Test.php'):\n            continue\n        path = os.path.join(root, fn)\n        cat = os.path.basename(root)\n        name = fn[:-len('Test.php')]\n        fqcn = (f'SineMacula\\\\CodingStandards\\\\PHPStan\\\\Rules\\\\{name}' if cat == 'PHPStan'\n                else f'SineMacula\\\\Sniffs\\\\{cat}\\\\{name}')\n        covers = [(fqcn, name)]\n        if cat in BASE:\n            covers.append(BASE[cat])\n\n        lines = open(path).readlines()\n        use_idx = [i for i, l in enumerate(lines) if l.startswith('use ')]\n        first = use_idx[0]\n        new_imports = ['use PHPUnit\\\\Framework\\\\Attributes\\\\CoversClass;\\n'] + [f'use {f};\\n' for f, _ in covers]\n        existing = [lines[i] for i in use_idx]\n        allimports = sorted(set(existing + new_imports))\n        non_use_after = [l for i, l in enumerate(lines) if i >= first and not l.startswith('use ')]\n        merged = lines[:first] + allimports + non_use_after\n\n        out = []\n        for l in merged:\n            if l.startswith('final class '):\n                for f, n in covers:\n                    out.append(f'#[CoversClass({n}::class)]\\n')\n            out.append(l)\n        open(path, 'w').writelines(out)\n        count += 1\nprint(f'rewrote {count} test files')\nPY\necho \"=== normalize with cs-fixer (it is satisfied by CoversClass, fixes import order) ===\"\nPHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --config=.qlty/configs/.php-cs-fixer.dist.php SineMacula/Tests 2>&1 | tail -2\necho \"=== sample result ===\"\nsed -n '5,20p' SineMacula/Tests/Metrics/MaxMethodCountSniffTest.php","cwd":".","session_id":"9a53099f-b58b-4687-996d-9f25e8e18acc","project_hash":"d0dd6af1f2bd","duration_ms":659}
