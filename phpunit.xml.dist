<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="SineMacula/Tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="SineMacula">
            <directory>SineMacula/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix="Sniff.php">SineMacula/Sniffs</directory>
        </include>
    </source>
</phpunit>
