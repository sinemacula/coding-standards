parameters:
    ignoreErrors:
        - identifier: argument.type
        - identifier: ternary.shortNotAllowed
        - identifier: booleanAnd.leftNotBoolean
        - identifier: booleanNot.exprNotBoolean
        - identifier: if.condNotBoolean
        - identifier: ternary.condNotBoolean
        - identifier: empty.notAllowed
        - identifier: staticMethod.alreadyNarrowedType
        - identifier: offsetAccess.nonOffsetAccessible
        - identifier: greaterOrEqual.alwaysTrue
        - identifier: smaller.alwaysTrue
        - identifier: classConstant.deprecated

    checkMissingCallableSignature: true
    checkMissingVarTagTypehint: true
    checkUninitializedProperties: true
    checkMissingOverrideMethodAttribute: true
    inferPrivatePropertyTypeFromConstructor: false
    reportUnmatchedIgnoredErrors: false

    # Require every checked exception a method can throw to be declared in its
    # @throws tag (and, via tooWideThrowType, no @throws that cannot be thrown).
    # The LogicException and RuntimeException families stay unchecked: they model
    # programming errors and runtime failures that propagate freely, so they need
    # no @throws. implicitThrows is off so an un-analysable call is not assumed to
    # throw Throwable.
    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException

services:
    -
        class: SineMacula\CodingStandards\PHPStan\Collectors\StaticPropertyWriteCollector
        tags:
            - phpstan.collector
    -
        class: SineMacula\CodingStandards\PHPStan\Collectors\StaticPropertyDeclarationCollector
        tags:
            - phpstan.collector

rules:
    - SineMacula\CodingStandards\PHPStan\Rules\NoMutableStaticPropertyRule
    - SineMacula\CodingStandards\PHPStan\Rules\RequireReadonlyClassRule
